{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_JWT_SECRET",
    "ANTHROPIC_API_KEY",
    "REDIS_URL",
    "ENCRYPTION_KEY",
    "VENTUS_CREDENTIAL_MASTER_KEY",
    "VENTUS_MCP_GATEWAY_SECRET",
    "VENTUS_GATEWAY_STATE_DIR",
    "VENTUS_REQUIRE_VERIFIED_AUTH",
    "VENTUS_DEV_DEFAULT_TENANT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
