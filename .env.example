# Node
NODE_ENV=development

# Supabase / Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace_me
# SERVICE_ROLE_KEY is highly privileged. Use only from packages/db/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=replace_me
# Dev-only: set to 1 to use a scripted FakeAgentRuntime instead of calling
# Anthropic. Lets you dogfood /runs/new + /runs/[id] without burning credits.
# NEVER set this in production.
# VENTUS_DEV_FAKE_RUNTIME=1

# Tenant credential encryption (per-tenant envelope encryption key)
# 32-byte base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace_me

# MCP gateway: per-tenant connector vault master key (HKDF input).
# 32-byte base64. Generate: openssl rand -base64 32
# Same value across api + mcp-gateway + worker — they decrypt the same blobs.
VENTUS_CREDENTIAL_MASTER_KEY=replace_me

# MCP gateway: HMAC secret over agent-runtime → gateway tool-call requests.
# At least 32 chars. Generate: openssl rand -base64 48
# Same value across agent-runtime + mcp-gateway.
VENTUS_MCP_GATEWAY_SECRET=replace_me

# MCP gateway: file-backed state directory (credentials.json + audit.json).
# Defaults to ./.gateway-state under the mcp-gateway cwd.
# VENTUS_GATEWAY_STATE_DIR=.gateway-state

# Supabase JWT verification on the API edge (HS256 against this secret).
# Local Supabase: pull via `supabase status` ("JWT secret"). Production: copy
# from the Supabase dashboard, never commit.
SUPABASE_JWT_SECRET=replace_me

# Boot-time auth gate. When set to 1, API refuses to start unless
# SUPABASE_JWT_SECRET is set and the dev header shim is OFF. NODE_ENV=production
# implies this; set explicitly in staging too.
# VENTUS_REQUIRE_VERIFIED_AUTH=1

# Dev-only: allow x-tenant-id / x-user-id / x-user-role header trust on the
# API when no Bearer token is present. NEVER set in production; the boot gate
# refuses to start if both this and VENTUS_REQUIRE_VERIFIED_AUTH are 1.
VENTUS_DEV_DEFAULT_TENANT=1

# Observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# OAuth (per connector)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
