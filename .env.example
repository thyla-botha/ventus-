# Node
NODE_ENV=development

# Supabase / Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace_me
# SERVICE_ROLE_KEY is highly privileged. Use only from packages/db/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=replace_me
# Dev-only: set to 1 to use a scripted FakeAgentRuntime instead of calling
# Anthropic. Lets you dogfood /runs/new + /runs/[id] without burning credits.
# NEVER set this in production.
# VENTUS_DEV_FAKE_RUNTIME=1

# Tenant credential encryption (per-tenant envelope encryption key)
# 32-byte base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace_me

# Observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# OAuth (per connector)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
