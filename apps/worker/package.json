{
  "name": "@ventus/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./reaper": "./src/reaper.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "reaper:dev": "tsx watch src/reaper-main.ts",
    "reaper": "node dist/reaper-main.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ventus/db": "workspace:*",
    "@ventus/shared": "workspace:*",
    "@ventus/audit": "workspace:*",
    "@ventus/store": "workspace:*",
    "bullmq": "^5.21.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.7.0",
    "vitest": "^2.1.0"
  }
}
