{
  "name": "ventus",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant agentic operations platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:tenancy && pnpm lint:schema-store",
    "lint:tenancy": "node scripts/lint-tenancy.mjs",
    "lint:schema-store": "node scripts/lint-schema-store.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0",
    "vitest": "^2.1.0"
  }
}
